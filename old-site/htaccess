RewriteEngine on
RewriteCond %{DOCUMENT_ROOT}/.websites%{REQUEST_URI} -f
RewriteRule ^(.*)$ .websites/$1 [L]
RewriteCond %{REQUEST_URI} ^/$
RewriteCond %{DOCUMENT_ROOT}/.websites/index.html -f
RewriteRule ^(.*)$ .websites/index.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ $1 [L]

